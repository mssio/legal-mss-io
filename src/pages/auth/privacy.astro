---
import Layout from '../../layouts/Layout.astro';
import { AUTH_CONTACT, PRIVACY_LAST_UPDATED } from '../../data/auth';
import PolicyNav from '../../components/PolicyNav.astro';
---

<Layout title="auth.mss.io Privacy Policy — legal.mss.io" width="max-w-[760px]" headerPadding="pb-10 sm:pb-12">
<PolicyNav slot="subnav" current="privacy" />
<!-- Main Content Area -->
<main class="flex-1 pt-8 sm:pt-10 space-y-12 sm:space-y-14">
<!-- Page Title & Header Meta -->
<section class="space-y-3 pb-8 border-b border-neutral-200/80 dark:border-neutral-800">
<div class="text-xs font-mono text-neutral-500 dark:text-neutral-400 uppercase tracking-wider">
          auth.mss.io
        </div>
<h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-neutral-900 dark:text-neutral-50">
          auth.mss.io Privacy Policy
        </h1>
<p class="text-[15px] sm:text-[16px] leading-relaxed text-neutral-600 dark:text-neutral-400 pt-1">
          Plain language privacy policy under Alberta PIPA and federal PIPEDA. Last updated {PRIVACY_LAST_UPDATED}.
        </p>
</section>
<!-- Section 1: Who we are -->
<section class="space-y-4" id="who-we-are">
<h2 class="text-lg font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 font-mono flex items-center gap-2">
<span>01.</span>
<span>Who we are</span>
</h2>
<div class="space-y-3.5 text-[15px] leading-relaxed text-neutral-700 dark:text-neutral-300">
<p>
<strong class="font-medium text-neutral-900 dark:text-white">auth.mss.io</strong> (the "Service") is the sign-in service operated by Mario Stefano Suharja, doing business as MSS, in Calgary, Alberta, Canada ("MSS", "we", "us"). This policy explains what personal information the Service collects when you create an account or sign in, why, and what choices you have.
          </p>
<p>
            We handle personal information in line with Alberta's <em>Personal Information Protection Act</em> (PIPA) and, where it applies, the federal <em>Personal Information Protection and Electronic Documents Act</em> (PIPEDA). Our privacy contact is reachable at <a class="underline decoration-neutral-300 dark:decoration-neutral-700 underline-offset-4 hover:text-accent dark:hover:text-accent-dark font-mono text-xs sm:text-sm text-neutral-900 dark:text-neutral-100 transition-colors" href={`mailto:${AUTH_CONTACT}`}>{AUTH_CONTACT}</a>.
          </p>
<p>
            This policy covers the Service only. Each application you sign in to (a "Connected Application") handles the information it receives under its own privacy policy.
          </p>
</div>
</section>
<!-- Section 2: What we collect -->
<section class="space-y-5" id="what-we-collect">
<h2 class="text-lg font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 font-mono flex items-center gap-2">
<span>02.</span>
<span>What we collect</span>
</h2>
<p class="text-[15px] text-neutral-700 dark:text-neutral-300">
          We collect only what is needed to create your account, sign you in securely and keep the Service safe.
        </p>
<!-- Clean Documentation Table -->
<div class="border border-neutral-200/80 dark:border-neutral-800 rounded-lg overflow-x-auto bg-white dark:bg-[#13161f]">
<table class="w-full text-left text-xs sm:text-sm border-collapse">
<thead>
<tr class="border-b border-neutral-200/80 dark:border-neutral-800 bg-neutral-50/70 dark:bg-neutral-800/30 text-neutral-700 dark:text-neutral-300 font-mono">
<th class="py-3 px-4 font-medium">Information</th>
<th class="py-3 px-4 font-medium">Where it comes from</th>
<th class="py-3 px-4 font-medium">Why we need it</th>
</tr>
</thead>
<tbody class="divide-y divide-neutral-200/70 dark:divide-neutral-800/70 text-neutral-600 dark:text-neutral-400">
<tr>
<td class="py-3 px-4 font-medium text-neutral-900 dark:text-neutral-200">Email address, username</td>
<td class="py-3 px-4 font-mono text-xs">You, at sign-up</td>
<td class="py-3 px-4">Identify your account, sign-in, verification and security notices</td>
</tr>
<tr>
<td class="py-3 px-4 font-medium text-neutral-900 dark:text-neutral-200">Password</td>
<td class="py-3 px-4 font-mono text-xs">You, at sign-up</td>
<td class="py-3 px-4">Authenticate you. Stored only as a salted one-way hash, never in readable form</td>
</tr>
<tr>
<td class="py-3 px-4 font-medium text-neutral-900 dark:text-neutral-200">Name, profile picture <span class="text-xs text-neutral-400 font-normal">(optional)</span></td>
<td class="py-3 px-4 font-mono text-xs">You, or a social sign-in provider</td>
<td class="py-3 px-4">Display in your profile and share with Connected Applications you approve</td>
</tr>
<tr>
<td class="py-3 px-4 font-medium text-neutral-900 dark:text-neutral-200">Social sign-in identifier and basic profile</td>
<td class="py-3 px-4 font-mono text-xs">Google, GitHub, Apple or similar, if you choose them</td>
<td class="py-3 px-4">Link that account to yours</td>
</tr>
<tr>
<td class="py-3 px-4 font-medium text-neutral-900 dark:text-neutral-200">Phone number <span class="text-xs text-neutral-400 font-normal">(if enabled)</span></td>
<td class="py-3 px-4 font-mono text-xs">You</td>
<td class="py-3 px-4">One-time codes and account recovery</td>
</tr>
<tr>
<td class="py-3 px-4 font-medium text-neutral-900 dark:text-neutral-200">MFA data: authenticator secrets, passkey public keys, backup codes</td>
<td class="py-3 px-4 font-mono text-xs">You, when you set up MFA</td>
<td class="py-3 px-4">Second-factor verification</td>
</tr>
<tr>
<td class="py-3 px-4 font-medium text-neutral-900 dark:text-neutral-200">IP address, browser and device details, timestamps</td>
<td class="py-3 px-4 font-mono text-xs">Your browser, automatically</td>
<td class="py-3 px-4">Sign-in logs, fraud and abuse detection, troubleshooting</td>
</tr>
<tr>
<td class="py-3 px-4 font-medium text-neutral-900 dark:text-neutral-200">Record of which Connected Applications you have authorized</td>
<td class="py-3 px-4 font-mono text-xs">Generated by the Service</td>
<td class="py-3 px-4">Show and manage your consents</td>
</tr>
</tbody>
</table>
</div>
<p class="text-[15px] text-neutral-700 dark:text-neutral-300">
          We do not collect payment information, and we do not ask for sensitive information such as health or financial data.
        </p>
</section>
<!-- Section 3: How we use and share it -->
<section class="space-y-4" id="how-we-use-and-share">
<h2 class="text-lg font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 font-mono flex items-center gap-2">
<span>03.</span>
<span>How we use and share it</span>
</h2>
<div class="space-y-3.5 text-[15px] leading-relaxed text-neutral-700 dark:text-neutral-300">
<p>
            We use your information only to run the Service: creating and securing your account, signing you in, sending verification and security emails, detecting abuse, and meeting legal obligations. By creating an account you consent to these uses. We do not sell your personal information, use it for advertising, or use it to train AI models.
          </p>
<p class="font-medium text-neutral-900 dark:text-neutral-100 pt-1">
            We share information only in these cases:
          </p>
<ul class="list-disc list-outside pl-5 space-y-2 text-neutral-600 dark:text-neutral-400 text-sm">
<li>
<strong class="text-neutral-900 dark:text-neutral-200 font-medium">Connected Applications you sign in to:</strong> They receive the details shown on the consent screen (typically a unique ID, email and name). You can revoke access later.
            </li>
<li>
<strong class="text-neutral-900 dark:text-neutral-200 font-medium">Service providers</strong> that help us operate the Service, under contracts that limit their use of the data:
              <ul class="list-none pl-3 pt-1 space-y-1.5 border-l-2 border-neutral-200 dark:border-neutral-800 my-1 text-xs sm:text-sm">
<li><strong class="text-neutral-800 dark:text-neutral-200">Cloudflare, Inc.:</strong> Network security and secure tunnelling; your connection to the Service passes through its global network, including the United States.</li>
<li><strong class="text-neutral-800 dark:text-neutral-200">Resend:</strong> Delivering verification and security emails.</li>
</ul>
</li>
<li>
<strong class="text-neutral-900 dark:text-neutral-200 font-medium">Legal reasons:</strong> When required by law, a court order or a valid legal request, or to protect the safety of users or the Service.
            </li>
<li>
<strong class="text-neutral-900 dark:text-neutral-200 font-medium">Business transfer:</strong> If the Service is sold or merged, information may transfer to the new operator, who must honour this policy.
            </li>
</ul>
<p class="text-xs text-neutral-500 dark:text-neutral-400 pt-1">
            Information processed by service providers outside Canada may be accessible to courts and authorities in those countries under their laws.
          </p>
</div>
</section>
<!-- Section 4: Storage, security and retention -->
<section class="space-y-4" id="storage-security-retention">
<h2 class="text-lg font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 font-mono flex items-center gap-2">
<span>04.</span>
<span>Storage, security &amp; retention</span>
</h2>
<div class="space-y-3.5 text-[15px] leading-relaxed text-neutral-700 dark:text-neutral-300">
<p>
            Account data is stored on servers we operate in <strong class="font-medium text-neutral-900 dark:text-white">Calgary, Alberta, Canada</strong>.
          </p>
<p>
            We protect it with reasonable safeguards, including encrypted connections (TLS), hashed passwords, multi-factor authentication options, network isolation of the database and administrative interfaces, restricted administrator access, and regular security updates. No system is perfectly secure. If a breach creates a real risk of significant harm to you, we will notify you and the relevant privacy commissioner as the law requires.
          </p>
<p>
            We do not currently keep backups of account data. Information that is deleted, whether at your request or through a system failure, cannot be recovered. We will update this policy before we start keeping backups.
          </p>
</div>
<div class="pt-2 space-y-3">
<h3 class="text-xs uppercase tracking-wider font-semibold text-neutral-500 dark:text-neutral-400 font-mono">
            Retention Schedule
          </h3>
<div class="border border-neutral-200/80 dark:border-neutral-800 rounded-lg overflow-x-auto bg-white dark:bg-[#13161f]">
<table class="w-full text-left text-xs sm:text-sm border-collapse">
<thead>
<tr class="border-b border-neutral-200/80 dark:border-neutral-800 bg-neutral-50/70 dark:bg-neutral-800/30 text-neutral-700 dark:text-neutral-300 font-mono">
<th class="py-2.5 px-4 font-medium">Information</th>
<th class="py-2.5 px-4 font-medium">How long</th>
</tr>
</thead>
<tbody class="divide-y divide-neutral-200/70 dark:divide-neutral-800/70 text-neutral-600 dark:text-neutral-400">
<tr>
<td class="py-2.5 px-4 font-medium text-neutral-900 dark:text-neutral-200">Account and profile data</td>
<td class="py-2.5 px-4">While your account is active; deleted within 30 days of an account deletion request</td>
</tr>
<tr>
<td class="py-2.5 px-4 font-medium text-neutral-900 dark:text-neutral-200">Sign-in and security logs</td>
<td class="py-2.5 px-4">Up to 90 days, then deleted</td>
</tr>
<tr>
<td class="py-2.5 px-4 font-medium text-neutral-900 dark:text-neutral-200">Information we must keep by law, or for an active dispute</td>
<td class="py-2.5 px-4">As long as that requirement lasts</td>
</tr>
</tbody>
</table>
</div>
</div>
</section>
<!-- Section 5: Cookies -->
<section class="space-y-4" id="cookies">
<h2 class="text-lg font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 font-mono flex items-center gap-2">
<span>05.</span>
<span>Cookies</span>
</h2>
<div class="space-y-3.5 text-[15px] leading-relaxed text-neutral-700 dark:text-neutral-300">
<p>
            The Service uses only strictly necessary cookies: session cookies that keep you signed in, and security cookies that protect sign-in flows against forgery. Cloudflare may also set a cookie to filter malicious traffic. We do not use analytics, advertising or tracking cookies. Blocking these cookies will prevent sign-in from working.
          </p>
</div>
</section>
<!-- Section 6: Your rights -->
<section class="space-y-4" id="your-rights">
<h2 class="text-lg font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 font-mono flex items-center gap-2">
<span>06.</span>
<span>Your rights</span>
</h2>
<div class="space-y-3.5 text-[15px] leading-relaxed text-neutral-700 dark:text-neutral-300">
<p>You can:</p>
<ul class="list-disc list-outside pl-5 space-y-2 text-neutral-600 dark:text-neutral-400 text-sm">
<li><strong class="text-neutral-900 dark:text-neutral-200 font-medium">Access</strong> the personal information we hold about you and learn how it has been used and shared.</li>
<li><strong class="text-neutral-900 dark:text-neutral-200 font-medium">Correct</strong> information that is inaccurate or incomplete (most details can be edited in your account settings).</li>
<li><strong class="text-neutral-900 dark:text-neutral-200 font-medium">Withdraw consent and delete your account</strong>, subject to legal limits. Deleting your account ends your ability to sign in to Connected Applications through the Service.</li>
<li><strong class="text-neutral-900 dark:text-neutral-200 font-medium">Revoke</strong> a Connected Application's access at any time.</li>
</ul>
<p class="text-sm">
            Send requests to <a class="underline decoration-neutral-300 dark:decoration-neutral-700 underline-offset-4 hover:text-accent dark:hover:text-accent-dark font-mono text-xs sm:text-sm text-neutral-900 dark:text-neutral-100 transition-colors" href={`mailto:${AUTH_CONTACT}`}>{AUTH_CONTACT}</a>. We may need to verify your identity first, and we will respond within 30 days, or tell you if we need an extension the law allows.
          </p>
<p class="text-sm text-neutral-600 dark:text-neutral-400">
            If you are not satisfied with our response, you can complain to the <a class="underline decoration-neutral-300 dark:decoration-neutral-700 underline-offset-4 hover:text-accent dark:hover:text-accent-dark text-neutral-900 dark:text-neutral-100 transition-colors" href="https://oipc.ab.ca" rel="noopener noreferrer" target="_blank">Office of the Information and Privacy Commissioner of Alberta</a> or the <a class="underline decoration-neutral-300 dark:decoration-neutral-700 underline-offset-4 hover:text-accent dark:hover:text-accent-dark text-neutral-900 dark:text-neutral-100 transition-colors" href="https://www.priv.gc.ca" rel="noopener noreferrer" target="_blank">Office of the Privacy Commissioner of Canada</a>.
          </p>
</div>
</section>
<!-- Section 7: Children, changes & contact -->
<section class="space-y-4" id="children-changes-contact">
<h2 class="text-lg font-semibold tracking-tight text-neutral-900 dark:text-neutral-100 font-mono flex items-center gap-2">
<span>07.</span>
<span>Children, changes &amp; contact</span>
</h2>
<div class="space-y-3.5 text-[15px] leading-relaxed text-neutral-700 dark:text-neutral-300">
<p>
            The Service is not intended for children under 13, and we do not knowingly collect their information. If you believe a child under 13 has created an account, contact us and we will delete it.
          </p>
<p>
            We may update this policy. We will change the "Last updated" date, and for material changes we will notify you by email or at sign-in before they take effect.
          </p>
</div>
</section>
<!-- Section: Contact (Matching legal.mss.io DL layout) -->
<section aria-labelledby="contact-heading" class="pt-6 border-t border-neutral-200/80 dark:border-neutral-800/80">
<h2 class="text-xs uppercase tracking-wider font-semibold text-neutral-400 dark:text-neutral-500 font-mono mb-4" id="contact-heading">
          Contact
        </h2>
<dl class="space-y-3.5 text-sm">
<div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between py-1 gap-1">
<dt class="text-neutral-600 dark:text-neutral-400">Privacy questions or requests</dt>
<dd>
<a class="text-neutral-900 dark:text-neutral-200 hover:text-accent dark:hover:text-accent-dark underline decoration-neutral-300 dark:decoration-neutral-700 underline-offset-4 font-mono text-xs sm:text-sm transition-colors" href={`mailto:${AUTH_CONTACT}`}>
                {AUTH_CONTACT}
              </a>
</dd>
</div>
<div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between py-1 gap-1">
<dt class="text-neutral-600 dark:text-neutral-400">Operator &amp; Privacy Officer</dt>
<dd class="text-neutral-900 dark:text-neutral-200 text-xs sm:text-sm">
              Mario Stefano Suharja, Calgary, Alberta, Canada
            </dd>
</div>
</dl>
</section>
</main>
<a slot="footer-links" class="hover:text-neutral-800 dark:hover:text-neutral-300 hover:underline transition-colors" href="/auth/terms">Terms of Use</a>
</Layout>
