---
import '../styles/global.css';

interface Props {
  title: string;
  /** Container width class: home uses 720px, policy pages 760px. */
  width?: string;
  /** Bottom padding under the header bar. */
  headerPadding?: string;
}

const {
  title,
  width = 'max-w-[720px]',
  headerPadding = 'pb-12 sm:pb-16',
} = Astro.props;

// On the home page the "/ legal.mss.io" label would link to itself
const isHome = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <!-- Apply the saved or OS theme before paint to avoid a flash -->
    <script is:inline>
      // Storage access throws when site data is blocked; fall back to the OS preference
      let saved = null;
      try {
        saved = localStorage.getItem('color-theme');
      } catch {}
      const dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.toggle('dark', dark);
    </script>
  </head>
  <body class="min-h-screen bg-[#fafafa] dark:bg-[#0f1117] text-[#171717] dark:text-[#f3f4f6] font-sans antialiased selection:bg-indigo-100 dark:selection:bg-indigo-950/80 transition-colors duration-200">
    <div class:list={[width, 'mx-auto px-6 sm:px-8 py-12 sm:py-20 flex flex-col min-h-screen']}>
      <!-- Top Bar: MSS Wordmark + Dark Mode Switcher -->
      <header class:list={['flex items-center justify-between border-b border-neutral-200/80 dark:border-neutral-800/80', headerPadding]}>
        <div class="flex items-center gap-3">
          <a href="/" class="text-base font-semibold tracking-tight text-neutral-900 dark:text-white uppercase hover:opacity-80 transition-opacity">
            MSS
          </a>
          {isHome ? (
            <span class="text-xs font-mono text-neutral-400 dark:text-neutral-500">/ legal.mss.io</span>
          ) : (
            <a href="/" class="text-xs font-mono text-neutral-400 dark:text-neutral-500 hover:text-neutral-600 dark:hover:text-neutral-300 transition-colors">/ legal.mss.io</a>
          )}
        </div>

        <button
          id="theme-toggle"
          type="button"
          aria-label="Toggle dark mode"
          class="inline-flex items-center gap-1.5 px-2.5 py-1.5 text-xs font-medium text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-200 rounded-md hover:bg-neutral-200/60 dark:hover:bg-neutral-800/60 transition-colors">
          <svg class="w-4 h-4 hidden dark:block text-neutral-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 9h-1m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg class="w-4 h-4 block dark:hidden text-neutral-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          <span class="sr-only sm:not-sr-only text-[11px] font-mono">Theme</span>
        </button>
      </header>

      <slot name="subnav" />

      <slot />

      <footer class="pt-16 sm:pt-20 mt-auto border-t border-neutral-200/80 dark:border-neutral-800/80 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-neutral-500 dark:text-neutral-500">
        <div>© 2026 MSS</div>
        {Astro.slots.has('footer-links') && (
          <div class="flex items-center gap-4">
            <slot name="footer-links" />
          </div>
        )}
      </footer>
    </div>

    <script>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('color-theme', isDark ? 'dark' : 'light');
        } catch {}
      });
    </script>
  </body>
</html>
